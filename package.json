{
  "name": "obsidian-bojo",
  "version": "1.0.0",
  "description": "Bullet Journal Todo Plugin for Obsidian - Consolidate and manage todos with bullet journal methodology",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "bullet-journal",
    "todo",
    "tasks"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "obsidian": "^1.5.3",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
